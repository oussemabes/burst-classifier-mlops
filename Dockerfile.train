FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only torch first (separate layer for caching — avoids re-download on code changes)
RUN pip install --no-cache-dir \
    torch==2.3.1 torchaudio==2.3.1 \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt pyproject.toml ./
COPY src ./src
COPY configs ./configs

# Install remaining deps (torch already present, skipped)
RUN pip install --no-cache-dir -r requirements.txt && pip install -e .

ENTRYPOINT ["python", "-m", "burst_classifier.train"]
CMD ["--config", "configs/default.yaml"]
